# MORTALS Dashboard - Email Verification Service Configuration

# Server Configuration
PORT=3001
NODE_ENV=development

# Email Service Configuration
# Supported services: gmail, outlook, yahoo, etc.
EMAIL_SERVICE=gmail

# Email Credentials
# For Gmail: Use App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Optional: Custom SMTP (overrides EMAIL_SERVICE when SMTP_HOST is set)
# Uncomment and configure if you want to use a custom SMTP server instead of a named service
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false  # true for port 465, false for 587/STARTTLS

# Stripe Billing (Subscription)
# Obtain keys from https://dashboard.stripe.com/test/apikeys
# And configure a recurring Price in Stripe, then paste its ID
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_PRO=price_1234567890abcdef

# Frontend URLs used after checkout/portal
STRIPE_SUCCESS_URL=http://localhost:3000/?upgrade=success
STRIPE_CANCEL_URL=http://localhost:3000/?upgrade=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/

# Instructions:
# 1. Copy this file to .env
# 2. Replace the EMAIL_USER with your email
# 3. Replace EMAIL_PASSWORD with your app-specific password
# 4. For Gmail: Enable 2FA and generate App Password
# 5. Keep .env file secure and never commit it to git
