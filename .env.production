# Production Environment - Vercel
NODE_ENV=production
PORT=3001

# Database (Neon.tech PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname

# API Configuration
CLIENT_URL=https://your-frontend-url.vercel.app
API_BASE_URL=https://your-backend-url.vercel.app

# Email Service (Gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_your_production_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret
STRIPE_PRICE_PRO=price_your_production_price_id

# Stripe URLs (update with production domain)
STRIPE_SUCCESS_URL=https://your-frontend-url.vercel.app/?upgrade=success
STRIPE_CANCEL_URL=https://your-frontend-url.vercel.app/?upgrade=cancel
STRIPE_PORTAL_RETURN_URL=https://your-frontend-url.vercel.app/

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_production_jwt_secret_here

# Frontend URL for CORS
FRONTEND_URL=https://your-frontend-url.vercel.app
